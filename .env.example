# Copiá este archivo como .env (junto al docker-compose.yml) y cambiá los valores.
POSTGRES_PASSWORD=cambiar_esta_clave
# Clave para firmar las sesiones. Usá una cadena larga y aleatoria (ej.: openssl rand -hex 32)
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria
# Zona horaria del comercio (para "hoy", cierres de caja y reportes)
TZ_NEGOCIO=America/Argentina/Buenos_Aires
# Puerto donde se publica la aplicación
APP_PORT=4000
